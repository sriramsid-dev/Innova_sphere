# Innova Sphere — Server Environment Variables
# Copy this file to .env.server and fill in your actual values.
# .env.server is gitignored and must NEVER be committed.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (optional, defaults to gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Express server port (optional, defaults to 3001)
PORT=3001

# Supabase project credentials (same project as .env.local)
# The anon key is sufficient — RLS on public.schemes handles access control.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Vite only reads these from .env.local — they are listed here so this file
# documents every variable the app needs. Copy them into .env.local.
# Both values are PUBLIC (they are embedded into the browser bundle), so use
# the project URL and the publishable/anon key only — never the service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
